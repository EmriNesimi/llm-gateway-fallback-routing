# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- Provider API keys ---
# Replace these, or delete the lines entirely. Leaving a placeholder in place
# is NOT the same as leaving the variable unset — the gateway detects these
# obviously fake values at startup, warns, and treats that provider as
# unconfigured, so it's skipped cleanly rather than called and 401ing on every
# request. See the error-handling section of the README.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# --- Ollama (local, no key needed) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# How long to wait to connect, and for a command to get a response, before
# failing fast rather than hanging on an unresponsive (not just down) Redis.
REDIS_CONNECT_TIMEOUT_SECONDS=5.0
REDIS_SOCKET_TIMEOUT_SECONDS=5.0

# --- Database (audit log / API key records) ---
# Defaults to a local SQLite file if unset — zero setup for local dev.
# For production, point at Postgres with the async driver, e.g.:
# DATABASE_URL=postgresql+asyncpg://gateway:changeme@localhost:5432/gateway
DATABASE_URL=sqlite+aiosqlite:///./gateway.db
# Only applied for a Postgres DATABASE_URL (ignored for SQLite). Same
# reasoning as the Redis timeouts above — bound how long a connect or a
# single query can hang before failing fast.
DATABASE_CONNECT_TIMEOUT_SECONDS=5.0
DATABASE_COMMAND_TIMEOUT_SECONDS=10.0

# --- Gateway security ---
# Secret used to hash/verify client API keys issued by this gateway
GATEWAY_SECRET_KEY=replace-with-a-long-random-string
# Comma-separated client API keys accepted by /v1/chat. If left empty the
# endpoint fails closed (503) so provider credits are never exposed openly.
# Callers pass a key via `Authorization: Bearer <key>` or the `X-API-Key` header.
GATEWAY_API_KEYS=replace-with-one-or-more-random-client-keys
# Shared secret for the admin API (issuing/revoking keys). Left unset, the
# admin API fails closed rather than being reachable by anyone.
ADMIN_API_KEY=replace-with-a-long-random-admin-secret

# --- Rate limiting (token bucket, per API key) ---
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=0.5

# --- Budgets ---
# Monthly USD spend cap per API key, resets automatically each period.
MONTHLY_BUDGET_USD_PER_KEY=5.0

# --- Model routing ---
# What to do when `model` names a chain that doesn't exist. false (default)
# serves it on the "default" chain and reports the substitution via the
# X-Gateway-Chain response header and a warning log; true rejects it with a 404
# listing the routable names. See docs/decisions/009-unknown-model-handling.md.
STRICT_MODEL_ROUTING=false

# --- Circuit breaker (per provider) ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0

# --- Retry (within a single provider, before falling back) ---
PROVIDER_RETRY_ATTEMPTS=1
PROVIDER_RETRY_BACKOFF_SECONDS=0.5

# --- Request timeouts (per provider HTTP call) ---
# OpenAI / Anthropic. Ollama gets its own, longer default since local
# generation is often slower than a hosted API.
PROVIDER_REQUEST_TIMEOUT_SECONDS=30.0
OLLAMA_REQUEST_TIMEOUT_SECONDS=60.0

# --- Observability ---
# Where to export traces. This value suits running the gateway on the host
# against the Jaeger that `docker compose up` starts (UI on :16686).
# docker-compose.yml overrides it to http://jaeger:4317 for the containerised
# gateway, since inside a container localhost is the container itself.
# Leave it unset and tracing is simply off — the app runs fine either way.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Logging ---
# "text" (default) for human-readable local logs, "json" for structured
# single-line logs a log aggregator (Loki, CloudWatch, etc.) can parse.
LOG_FORMAT=text

# --- CORS ---
# Comma-separated browser origins allowed to call this gateway directly.
# Empty by default (no CORS middleware at all) since this API is normally
# called server-to-server or via curl, not from a browser.
CORS_ALLOWED_ORIGINS=
