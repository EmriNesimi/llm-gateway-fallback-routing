# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- Provider API keys ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# --- Ollama (local, no key needed) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Postgres (audit log / team config) ---
DATABASE_URL=postgresql://gateway:changeme@localhost:5432/gateway

# --- Gateway security ---
# Secret used to hash/verify client API keys issued by this gateway
GATEWAY_SECRET_KEY=replace-with-a-long-random-string
# Comma-separated client API keys accepted by /v1/chat. If left empty the
# endpoint fails closed (503) so provider credits are never exposed openly.
# Callers pass a key via `Authorization: Bearer <key>` or the `X-API-Key` header.
GATEWAY_API_KEYS=replace-with-one-or-more-random-client-keys

# --- Rate limiting (token bucket, per API key) ---
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=0.5

# --- Budgets ---
# Monthly USD spend cap per API key, resets automatically each period.
MONTHLY_BUDGET_USD_PER_KEY=5.0

# --- Circuit breaker (per provider) ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
