# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- Provider API keys ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# --- Ollama (local, no key needed) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Database (audit log / API key records) ---
# Defaults to a local SQLite file if unset — zero setup for local dev.
# For production, point at Postgres with the async driver, e.g.:
# DATABASE_URL=postgresql+asyncpg://gateway:changeme@localhost:5432/gateway
DATABASE_URL=sqlite+aiosqlite:///./gateway.db

# --- Gateway security ---
# Secret used to hash/verify client API keys issued by this gateway
GATEWAY_SECRET_KEY=replace-with-a-long-random-string
# Comma-separated client API keys accepted by /v1/chat. If left empty the
# endpoint fails closed (503) so provider credits are never exposed openly.
# Callers pass a key via `Authorization: Bearer <key>` or the `X-API-Key` header.
GATEWAY_API_KEYS=replace-with-one-or-more-random-client-keys
# Shared secret for the admin API (issuing/revoking keys). Left unset, the
# admin API fails closed rather than being reachable by anyone.
ADMIN_API_KEY=replace-with-a-long-random-admin-secret

# --- Rate limiting (token bucket, per API key) ---
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=0.5

# --- Budgets ---
# Monthly USD spend cap per API key, resets automatically each period.
MONTHLY_BUDGET_USD_PER_KEY=5.0

# --- Circuit breaker (per provider) ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0

# --- Retry (within a single provider, before falling back) ---
PROVIDER_RETRY_ATTEMPTS=1
PROVIDER_RETRY_BACKOFF_SECONDS=0.5

# --- Request timeouts (per provider HTTP call) ---
# OpenAI / Anthropic. Ollama gets its own, longer default since local
# generation is often slower than a hosted API.
PROVIDER_REQUEST_TIMEOUT_SECONDS=30.0
OLLAMA_REQUEST_TIMEOUT_SECONDS=60.0

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- CORS ---
# Comma-separated browser origins allowed to call this gateway directly.
# Empty by default (no CORS middleware at all) since this API is normally
# called server-to-server or via curl, not from a browser.
CORS_ALLOWED_ORIGINS=
